# ==============================================================================
# mysqllab Configuration
# ==============================================================================

# Option 1: Live MySQL URL connection
# When specified, the app connects directly to this MySQL server instance.
# Tables ('products', 'orders', 'order_items') will be automatically created on startup.
# DATABASE_URL=mysql://user:password@localhost:3306/mysqllab

# Option 2: Local SQLite file storage (Default fallback when no URL is provided)
# SQLITE_PATH=data/mysqllab.db
